# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Comma-separated explicit origin allowlist (never '*' when credentials are enabled)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Request hardening
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=15000

# Rate limiting (in-memory per-instance default; replace store with Redis when horizontally scaling)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Supabase PostgreSQL Connections
# Runtime app MUST use Supavisor transaction pooler (port 6543). Prepared statements are disabled automatically.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Migrations (drizzle-kit) ONLY: use Supavisor session pooler (port 5432, IPv4-compatible) or direct host (IPv6-only without add-on).
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Pool sizing (keep instances * DB_POOL_MAX under your Supabase connection limit)
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_SEC=20
DB_CONNECT_TIMEOUT_SEC=10

# Custom Auth (Option B: Argon2id + HS256 JWT + Refresh Token Rotation)
# Generate with: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-cryptographically-random-secret-at-least-32-chars
JWT_ISSUER=project-1-api
JWT_AUDIENCE=project-1-client
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
