{
  "name": "project-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . && bun --bun prettier --check .",
    "format": "bun --bun prettier --write .",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:refresh": "bun run src/db/refresh.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "docs:openapi": "bun --preload ./src/test/setup.ts scripts/export-openapi.ts",
    "docs:check": "bun --preload ./src/test/setup.ts scripts/export-openapi.ts --check",
    "docs:postman": "bun run scripts/export-postman-json.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
